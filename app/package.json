{
  "name": "agentgauge",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "tauri dev",
    "restart": "bun run scripts/restart.ts",
    "build": "tsc && vite build",
    "build:e2e": "tsc && vite build --mode e2e",
    "preflight:release:macos-arm64": "bash scripts/preflight-release-macos-arm64.sh",
    "clean": "bun run clean:rust && bun run clean:frontend && bun run clean:widget",
    "clean:rust": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "clean:frontend": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "clean:widget": "./src-tauri/widget/build-widget.sh clean",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons:generate": "bun run scripts/generate-icons.ts",
    "e2e:build": "bun run build:e2e && touch src-tauri/build.rs && cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol",
    "e2e": "bun run e2e:build && wdio run ./e2e/wdio.conf.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "widget:build": "./src-tauri/widget/build-widget.sh build",
    "widget:embed": "./src-tauri/widget/build-widget.sh embed",
    "widget:dev": "bun scripts/widget-dev.ts",
    "build:mac": "tauri build --bundles app && ./src-tauri/widget/build-widget.sh all ./src-tauri/target/release/bundle/macos/AgentGauge.app"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-beta.107",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "effect": "4.0.0-beta.107",
    "lucide-react": "^1.53.0",
    "radix-ui": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.107",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@wdio/cli": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "@wdio/tauri-plugin": "^1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "expect-webdriverio": "6.1.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1",
    "webdriverio": "^9"
  }
}
