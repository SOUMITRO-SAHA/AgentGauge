{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentGauge",
  "mainBinaryName": "agentgauge",
  "version": "0.1.0",
  "identifier": "com.soumitrasaha.agentgauge",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AgentGauge",
        "width": 960,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
