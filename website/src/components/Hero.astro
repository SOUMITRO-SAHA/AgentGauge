---
import { site } from '../config/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const assurances = [
	{ icon: 'lock-simple' as const, label: 'No API keys, ever' },
	{ icon: 'desktop' as const, label: 'Runs entirely on your Mac' },
	{ icon: 'shield-check' as const, label: 'No account, no usage uploads' },
];
---

<section id="top" class="relative isolate overflow-hidden">
	<div
		class="pointer-events-none absolute inset-0 -z-10"
		style="background-image: radial-gradient(55% 45% at 50% -5%, color-mix(in oklch, var(--brand-teal) 16%, transparent), transparent 70%), radial-gradient(40% 35% at 85% 5%, color-mix(in oklch, var(--brand-amber) 12%, transparent), transparent 70%)"
	>
	</div>
	<div
		class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px"
		style="background: linear-gradient(90deg, transparent, color-mix(in oklch, var(--brand-teal) 45%, transparent), transparent)"
	>
	</div>

	<div
		class="mx-auto flex w-full max-w-6xl flex-col items-center px-4 pt-16 pb-20 text-center sm:px-6 sm:pt-24 sm:pb-28"
	>
		<p
			class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-raised/70 px-3 py-1 text-xs font-medium text-muted-foreground backdrop-blur-md"
		>
			<span class="relative flex size-1.5">
				<span
					class="absolute inline-flex size-full animate-ping rounded-full bg-brand-teal opacity-75"
					aria-hidden="true"></span>
				<span class="relative inline-flex size-1.5 rounded-full bg-brand-teal"></span>
			</span>
			Early access · macOS only right now
		</p>

		<div class="mt-6 flex items-center gap-3">
			<Logo class="size-11 text-foreground" />
			<span class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
				{site.name}
			</span>
		</div>

		<h1
			class="mt-6 max-w-4xl font-display text-4xl leading-[1.08] font-bold tracking-tight text-balance text-foreground sm:text-6xl"
		>
			Know what your AI coding subscriptions have left — <span
				class="bg-gradient-to-r from-brand-teal to-brand-amber bg-clip-text text-transparent"
				>before you run out</span
			>.
		</h1>

		<p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-muted-foreground">
			AgentGauge reads the coding harnesses you already run — Codex, and the plans OpenCode
			has connected — and shows the usage windows, reset times, and honest numbers they
			actually expose. It never asks for your API keys.
		</p>

		<div class="mt-9 flex flex-col items-center gap-3 sm:flex-row">
			{
				site.downloadsAvailable ? (
					<a
						href={`${site.downloadsBaseUrl}/AgentGauge-universal.dmg`}
						class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-brand-ink px-7 text-sm font-semibold text-background transition-all hover:opacity-90 dark:bg-foreground dark:text-background"
					>
						Download for macOS
					</a>
				) : (
					<a
						href={site.repository}
						class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-brand-ink px-7 text-sm font-semibold text-background transition-all hover:opacity-90 dark:bg-foreground dark:text-background"
					>
						View on GitHub
					</a>
				)
			}
			<a
				href="#how-it-works"
				class="inline-flex h-12 items-center justify-center rounded-md border border-border bg-surface-raised px-7 text-sm font-semibold text-foreground transition-colors hover:bg-muted"
			>
				See how it works
			</a>
		</div>

		<ul
			class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-muted-foreground sm:text-sm"
		>
			{
				assurances.map((item) => (
					<li class="flex items-center gap-1.5">
						<Icon name={item.icon} class="size-4 text-brand-teal" />
						{item.label}
					</li>
				))
			}
		</ul>
	</div>
</section>
