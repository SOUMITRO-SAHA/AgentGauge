---
import { features, readings } from '../data/content';
import Icon from './Icon.astro';
---

<section id="features" class="scroll-mt-24 border-y border-border bg-surface-sunken/40 py-16 sm:py-24">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold tracking-wide text-brand-teal uppercase">Capabilities</p>
			<h2
				class="mt-3 font-display text-3xl font-bold tracking-tight text-balance text-foreground sm:text-4xl"
			>
				Built to be believed
			</h2>
			<p class="mt-3 text-lg leading-relaxed text-muted-foreground">
				A usage dashboard is only worth opening if you trust it. These are the choices that
				make that possible.
			</p>
		</div>

		<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				features.map((feature, index) => (
					<article
						data-reveal
						style={`--reveal-delay:${(index % 3) * 90}ms`}
						class="group rounded-lg border border-border/70 bg-surface-raised/70 p-6 backdrop-blur-md transition-colors hover:border-brand-teal/40"
					>
						<span class="inline-flex size-10 items-center justify-center rounded-md bg-brand-teal/10 text-brand-teal">
							<Icon name={feature.icon} class="size-5" />
						</span>
						<h3 class="mt-4 font-display text-base font-semibold text-foreground">
							{feature.title}
						</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">{feature.body}</p>
					</article>
				))
			}
		</div>

		<div data-reveal class="mt-4 rounded-lg border border-border/70 bg-surface-raised/70 p-6 backdrop-blur-md sm:p-8">
			<h3 class="font-display text-xl font-semibold text-foreground">
				Five readings, five different meanings
			</h3>
			<p class="mt-2 max-w-3xl leading-relaxed text-muted-foreground">
				The most common way a usage dashboard lies is by turning “I do not know” into
				“zero”. AgentGauge keeps these apart, and always shows the reason.
			</p>

			<ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
				{
					readings.map((reading) => (
						<li class="rounded-md border border-border/70 bg-surface-sunken/60 p-4">
							<span class="flex items-center gap-2 font-display text-sm font-semibold text-foreground">
								<Icon name={reading.icon} class="size-4 text-brand-teal" />
								{reading.state}
							</span>
							<p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
								{reading.meaning}
							</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
