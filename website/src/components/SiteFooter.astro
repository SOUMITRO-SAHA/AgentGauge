---
import { site } from '../config/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const nav = [
	{ href: '#pillars', label: 'Product' },
	{ href: '#how-it-works', label: 'How it works' },
	{ href: '#integrations', label: 'Integrations' },
	{ href: '#faq', label: 'FAQ' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface-sunken/40">
	<div
		class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 md:flex-row md:justify-between"
	>
		<div class="max-w-sm">
			<div class="flex items-center gap-2">
				<Logo class="size-6 text-foreground" />
				<span class="font-display font-semibold text-foreground">{site.name}</span>
			</div>
			<p class="mt-3 text-sm leading-relaxed text-muted-foreground">
				A local-first desktop companion for AI coding harnesses. Built on macOS.
			</p>
			<a
				href={site.repository}
				class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-foreground transition-colors hover:text-brand-teal"
			>
				<Icon name="github-logo" class="size-4" />
				SOUMITRO-SAHA/AgentGauge
			</a>
		</div>

		<nav aria-label="Footer">
			<h2 class="text-xs font-semibold tracking-wide text-muted-foreground uppercase">Explore</h2>
			<ul class="mt-4 flex flex-col gap-2.5">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								class="text-sm text-muted-foreground transition-colors hover:text-foreground"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	<div class="mx-auto w-full max-w-6xl px-4 pb-8 sm:px-6">
		<div class="border-t border-border pt-6">
			<p class="text-xs leading-relaxed text-muted-foreground">
				&copy; {year} {site.name}. {site.license}. macOS is the only platform we have shipped;
				Windows and Linux are still to come.
			</p>
		</div>
	</div>
</footer>
