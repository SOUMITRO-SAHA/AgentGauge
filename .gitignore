# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Dependencies and build output
node_modules
dist
dist-ssr
target
*.local

# Test artifacts (e2e screenshots, scratch files)
.temp

# Xcode DerivedData for the macOS widget extension
app/src-tauri/widget/build/
app/src-tauri/widget/**/xcuserdata/

# Cloned upstream references (e.g. .agents/references/effect, ~59MB)
.agents/references/

# Task registry: local to the clone, except research/ which is committed so
# findings persist. `tasks/*` rather than `tasks/` so the research dir can be
# re-included — git cannot re-include a path under an ignored directory.
.agents/tasks/*
!.agents/tasks/research/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/

# Operating system files
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
